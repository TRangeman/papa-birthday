{
  "name": "papa-birthday",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "payload": "node scripts/build-payload.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "check": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --nojekyll"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "gh-pages": "^6.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0"
  }
}
